wifi_ssid: "YourWifiSSID"
wifi_password: "YourWifiPassword"

# Generate with: openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_32_BYTE_BASE64_KEY"

# BLE MAC addresses of each LEGO Powered Up hub, found via esphome/scan_hubs.yaml
# (see docs/ble_mac_scan.md). Format: "AA:BB:CC:DD:EE:FF"
hub1_mac: "AA:AA:AA:AA:AA:AA"
hub2_mac: "BB:BB:BB:BB:BB:BB"
hub3_mac: "CC:CC:CC:CC:CC:CC"
hub4_mac: "DD:DD:DD:DD:DD:DD"
